    {
      "parameters": {
        "jsCode": "const apiResp = $input.first().json;\nconst ctx = $('Build Marcus Prompt').first().json;\nconst rawText = apiResp.content?.[0]?.text || '';\n\nconst copyMatch = rawText.match(/\\*\\*Post Copy:\\*\\*\\s*([\\s\\S]*?)(?=\\*\\*Image Direction:\\*\\*|$)/i);\nconst imgMatch = rawText.match(/\\*\\*Image Direction:\\*\\*\\s*([\\s\\S]*?)$/i);\n\nconst post_copy = copyMatch ? copyMatch[1].trim() : rawText;\nconst image_direction = imgMatch ? imgMatch[1].trim() : '(See post copy)';\n\nreturn [{ json: { ...ctx, post_copy, image_direction } }];"
      },
      "id": "00000000-0000-0000-0000-000000000016",
      "name": "Parse Marcus Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        1008
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
