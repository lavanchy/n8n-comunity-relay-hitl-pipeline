      "parameters": {
        "jsCode": "const apiResp = $input.first().json;\nconst ctx = $('Build Sofia Prompt').first().json;\nconst sofia_angles = apiResp.content?.[0]?.text || '';\nreturn [{ json: { ...ctx, sofia_angles } }];"
