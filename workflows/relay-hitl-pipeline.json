        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 800, messages: [{ role: 'user', content: `You are Taylor, a content quality reviewer at Relay.\\n\\nPost copy: ${$json.post_copy}\\nImage direction: ${$json.image_direction}\\nPlatform: ${$json.platform}\\nOriginal brief: ${$json.topic_hint}\\n\\n### Brand Context\\n${$json.brand_guide}\\n\\n### Platform Context\\n${$json.platform_playbook}\\n\\nAnalyze this and respond ONLY with valid JSON (no markdown, no preamble):\\n{\\n  \"summary\": \"2-3 sentence description\",\\n  \"quality_flags\": [\"flag1\", \"flag2\"],\\n  \"recommendation\": \"approve | needs_revision | reject_to_sofia\",\\n  \"reasoning\": \"brief explanation\"\\n}\\n\\nBe strict on brand fit.` }] }) }}",
        "options": {}
      },
      "id": "00000000-0000-0000-0000-000000000017",
      "name": "Taylor Preview Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1216,
        1008
      ],
      "credentials": {
        "anthropicApi": {
          "id": "{{ANTHROPIC_CRED_ID}}",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const apiResp = $input.first().json;\nconst ctx = $('Parse Marcus Output').first().json;\nlet preview;\ntry {\n  const raw = (apiResp.content?.[0]?.text || '{}').replace(/```json\\n?/g,'').replace(/```\\n?/g,'').trim();\n  preview = JSON.parse(raw);\n} catch(e) {\n  preview = { summary: '(Preview unavailable)', quality_flags: [], recommendation: 'needs_review', reasoning: 'Parse error' };\n}\n\nconst flags = preview.quality_flags?.length > 0\n  ? preview.quality_flags.map(f => `- ${f}`).join('\\n')\n  : '- No flags identified';\n\nconst taylor_preview_md = `**Taylor Preview (AI)**\\n\\n**Summary:** ${preview.summary}\\n\\n**Quality Flags:**\\n${flags}\\n\\n**Recommendation:** ${preview.recommendation}\\n**Reasoning:** ${preview.reasoning}`;\n\nreturn [{ json: { ...ctx, taylor_preview_md, taylor_preview_json: preview } }];"
      },
      "id": "00000000-0000-0000-0000-000000000018",
      "name": "Format Taylor Preview",
