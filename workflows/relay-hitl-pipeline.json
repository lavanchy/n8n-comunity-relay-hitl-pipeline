    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst decision = d.sofia_decision || '';\nlet approved_angle = decision.replace(/^Approve:?\\s*/i, '').trim();\nif (!approved_angle) approved_angle = (d.sofia_angles || '').split('\\n')[0];\nreturn [{ json: { ...d, approved_angle, sofia_feedback: '' } }];"
