    },
    {
      "parameters": {
        "jsCode": "const apiResp = $input.first().json;\nconst ctx = $('Build Taylor Prompt').first().json;\nconst rawText = apiResp.content?.[0]?.text || '';\n\nconst summaryMatch = rawText.match(/\\*\\*Summary\\*\\*[:\\s]*([\\s\\S]*?)(?=\\*\\*Quality Flags|$)/i);\nconst flagsMatch = rawText.match(/\\*\\*Quality Flags\\*\\*[:\\s]*([\\s\\S]*?)(?=\\*\\*AI Recommendation|$)/i);\nconst recMatch = rawText.match(/\\*\\*AI Recommendation\\*\\*[:\\s]*(approve|needs_revision|reject_to_sofia)/i);\nconst reasonMatch = rawText.match(/\\*\\*Brief reasoning\\*\\*[:\\s]*([\\s\\S]*?)$/i);\n\nreturn [{ json: {\n  ...ctx,\n  ai_summary: summaryMatch ? summaryMatch[1].trim() : rawText,\n  ai_flags: flagsMatch ? flagsMatch[1].trim() : '',\n  ai_recommendation: recMatch ? recMatch[1].trim() : 'needs_revision',\n  ai_reasoning: reasonMatch ? reasonMatch[1].trim() : ''\n}}];"
      },
      "id": "00000000-0000-0000-0000-000000000026",
      "name": "Parse Taylor Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        1712
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst ctx = $('Parse Taylor Analysis').first().json;\n\nconst decision = d.taylor_decision || d.data?.taylor_decision || d.response?.taylor_decision || '';\nconst notes = d.taylor_notes || d.data?.taylor_notes || d.response?.taylor_notes || '';\nconst round = (ctx.taylor_approval_round || 0) + 1;\n\nreturn [{ json: { ...ctx, taylor_decision: decision, taylor_notes: notes, taylor_approval_round: round } }];"
      },
